# Domain plan
API_DOMAIN=api.ptc-aibale.codistan.org
APP_DOMAIN=aws.ptc-aibale.codistan.org
TLS_EMAIL=replace-with-valid-notification-email@codistan.org

# PostgreSQL remains internal to the Docker network.
POSTGRES_DB=ptc_bale
POSTGRES_USER=ptc_app
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
DATABASE_URL=postgresql://ptc_app:replace-with-the-same-password@postgres:5432/ptc_bale?schema=public

NODE_ENV=production
PORT=4000
SESSION_COOKIE_NAME=ptc_session
SESSION_TTL_HOURS=8
COOKIE_SECURE=true
TRUST_PROXY=true
ALLOWED_ORIGINS=https://ptc-aibale.codistan.org,https://aws.ptc-aibale.codistan.org

# Machine ingestion token must be stored in Parameter Store and rotated independently of user passwords.
INGESTION_SERVICE_TOKEN=replace-with-at-least-32-random-characters

# Evidence remains outside PostgreSQL and outside the public web root.
EVIDENCE_ROOT=/var/lib/ptc-bale/evidence
MAX_EVIDENCE_BYTES=26214400

# Immutable release identity injected during deployment.
BUILD_VERSION=replace-with-release-version
BUILD_COMMIT=replace-with-git-commit
SCHEMA_VERSION=20260731-production-readiness

# Simulator is forbidden in production.
SIMULATOR_ENABLED=false

# Synthetic staging users. Store privately and rotate before client access.
SEED_VIEWER_PASSWORD=replace-with-a-strong-viewer-password
SEED_SUPERVISOR_PASSWORD=replace-with-a-strong-supervisor-password
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_ON_FIRST_DEPLOY=true

BACKUP_RETENTION_DAYS=14
