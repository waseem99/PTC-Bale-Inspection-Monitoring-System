# Domain plan
API_DOMAIN=api.ptc-aibale.codistan.org
APP_DOMAIN=aws.ptc-aibale.codistan.org
TLS_EMAIL=replace-with-valid-notification-email@codistan.org

# PostgreSQL
# Staging may use the internal Docker service shown below.
# For approved Option A production/non-production certification, override DATABASE_URL
# through protected runtime configuration so it points to the separate PostgreSQL host.
# Never commit the real remote hostname, username or password.
POSTGRES_DB=ptc_bale
POSTGRES_USER=ptc_app
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
DATABASE_URL=postgresql://ptc_app:replace-with-the-same-password@postgres:5432/ptc_bale?schema=public

NODE_ENV=production
PORT=4000
SESSION_COOKIE_NAME=ptc_session
SESSION_TTL_HOURS=720
SESSION_ABSOLUTE_TTL_HOURS=720
COOKIE_SECURE=true
TRUST_PROXY=true
ALLOWED_ORIGINS=https://ptc-aibale.codistan.org,https://aws.ptc-aibale.codistan.org

# Identity: local remains the PoC/offline default.
AUTH_MODE=local
# For later PTC enterprise IAM activation only; store real values in protected runtime configuration.
# AUTH_MODE=oidc
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=<application-client-id>
# OIDC_CALLBACK_URL=https://<approved-host>/api/auth/oidc/callback
# OIDC_AUDIENCE=<expected-audience>
# OIDC_USERNAME_CLAIM=preferred_username
# OIDC_ROLE_CLAIM=groups
# OIDC_VIEWER_GROUPS=<approved-group-id>
# OIDC_SUPERVISOR_GROUPS=<approved-group-id>
# OIDC_ADMIN_GROUPS=<approved-group-id>

# Machine ingestion token must be stored in Parameter Store and rotated independently of user passwords.
INGESTION_SERVICE_TOKEN=replace-with-at-least-32-random-characters

# Evidence remains outside PostgreSQL and outside the public web root.
EVIDENCE_ROOT=/var/lib/ptc-bale/evidence
MAX_EVIDENCE_BYTES=26214400

# Immutable release identity injected during deployment.
BUILD_VERSION=replace-with-release-version
BUILD_COMMIT=replace-with-git-commit
SCHEMA_VERSION=20260731-production-readiness

# Simulator is forbidden in production.
SIMULATOR_ENABLED=false

# Synthetic staging users. Store privately and rotate before client access.
SEED_VIEWER_PASSWORD=replace-with-a-strong-viewer-password
SEED_SUPERVISOR_PASSWORD=replace-with-a-strong-supervisor-password
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_ON_FIRST_DEPLOY=true

# Backup/recovery configuration used by the Option A execution package.
AWS_REGION=replace-with-approved-region
ARTIFACT_BUCKET=replace-with-approved-private-backup-bucket
BACKUP_RETENTION_DAYS=14
POSTGRES_CLIENT_IMAGE=postgres:16

# Do not persist RESTORE_DATABASE_URL in committed files. Supply it only for an
# approved disposable/non-production restore test together with:
# CONFIRM_DISPOSABLE_RESTORE=YES
