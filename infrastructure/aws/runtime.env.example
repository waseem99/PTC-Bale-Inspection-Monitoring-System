# Domain plan:
# - ptc-aibale.codistan.org is the primary Vercel-hosted application.
# - api.ptc-aibale.codistan.org is the public AWS EC2 API origin.
# - aws.ptc-aibale.codistan.org is the optional AWS-hosted frontend/fallback.
# Point the two AWS hostnames to the CloudFormation Elastic IP.
API_DOMAIN=api.ptc-aibale.codistan.org
APP_DOMAIN=aws.ptc-aibale.codistan.org
TLS_EMAIL=replace-with-valid-notification-email@codistan.org

# PostgreSQL runs only inside the Docker network and is not exposed publicly.
POSTGRES_DB=ptc_bale
POSTGRES_USER=ptc_app
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
DATABASE_URL=postgresql://ptc_app:replace-with-the-same-password@postgres:5432/ptc_bale?schema=public

NODE_ENV=production
PORT=4000
SESSION_COOKIE_NAME=ptc_session
SESSION_TTL_HOURS=8
COOKIE_SECURE=true
TRUST_PROXY=true

# Exact approved staging origins. Do not wildcard Vercel preview domains.
ALLOWED_ORIGINS=https://ptc-aibale.codistan.org,https://aws.ptc-aibale.codistan.org

# Synthetic staging users. Keep these outside Git and rotate before client access.
SEED_VIEWER_PASSWORD=replace-with-a-strong-viewer-password
SEED_SUPERVISOR_PASSWORD=replace-with-a-strong-supervisor-password
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_ON_FIRST_DEPLOY=true

# Deployment and backup settings injected into the release by the deployment script.
BACKUP_RETENTION_DAYS=14
