{
  email {$TLS_EMAIL}
  admin off
}

# AWS API origin: api.ptc-aibale.codistan.org
{$API_DOMAIN} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
  }
  reverse_proxy api:4000
}

# AWS-hosted frontend/fallback: aws.ptc-aibale.codistan.org
# The primary ptc-aibale.codistan.org hostname remains on Vercel until an approved cutover.
{$APP_DOMAIN} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
  }

  handle /api/* {
    reverse_proxy api:4000
  }

  handle {
    reverse_proxy dashboard:8080
  }
}
