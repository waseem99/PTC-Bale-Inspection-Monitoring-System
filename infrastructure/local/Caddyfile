{
  admin off
  auto_https off
  servers {
    read_timeout 30s
    write_timeout 0s
    idle_timeout 5m
  }
}

:80 {
  encode zstd gzip

  log {
    output file /var/log/caddy/access.log {
      roll_size 20MiB
      roll_keep 5
      roll_keep_for 168h
    }
    format json
  }

  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Cross-Origin-Opener-Policy "same-origin"
    Cross-Origin-Resource-Policy "same-origin"
    -Server
  }

  @realtime path /api/realtime /api/realtime/*
  handle @realtime {
    reverse_proxy api:4000 {
      flush_interval -1
      transport http {
        keepalive 5m
      }
    }
  }

  handle /api/* {
    reverse_proxy api:4000
  }

  handle /healthz {
    respond "ok" 200
  }

  handle {
    reverse_proxy dashboard:8080
  }
}
