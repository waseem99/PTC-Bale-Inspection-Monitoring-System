# Copy only through scripts/local/bootstrap.*. The generated runtime file must live outside the Git repository.

# Absolute host path. Use forward slashes on Windows, for example C:/PTC-Bale/data.
PTC_DATA_ROOT=/absolute/path/to/ptc-bale-data

# Workstation-only by default. Set 0.0.0.0 only for an approved trusted-LAN test.
LOCAL_BIND_ADDRESS=127.0.0.1
LOCAL_HTTP_PORT=8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Runtime mode: simulator or hardware-ready.
PTC_RUNTIME_MODE=simulator

POSTGRES_DB=ptc_bale
POSTGRES_USER=ptc_app
POSTGRES_PASSWORD=replace-with-generated-random-password
DATABASE_URL=postgresql://ptc_app:replace-with-url-encoded-generated-password@postgres:5432/ptc_bale?schema=public

SESSION_COOKIE_NAME=ptc_session
SESSION_TTL_HOURS=8
SEED_VIEWER_PASSWORD=replace-with-generated-viewer-password
SEED_SUPERVISOR_PASSWORD=replace-with-generated-supervisor-password
SEED_ADMIN_PASSWORD=replace-with-generated-admin-password
INGESTION_SERVICE_TOKEN=replace-with-generated-random-ingestion-token

MAX_EVIDENCE_BYTES=26214400
EDGE_FLUSH_INTERVAL_SECONDS=5
EDGE_HTTP_TIMEOUT_SECONDS=15
SIMULATOR_SEQUENCE_BASE=1000
SIMULATOR_GENERATE_EVERY_SECONDS=300

IMAGE_TAG=local
BUILD_VERSION=local-development
BUILD_COMMIT=unknown
SCHEMA_VERSION=20260731-camera-contract-v1
