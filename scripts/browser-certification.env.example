# Copy this file to a secure local path outside Git and replace placeholders.
# Never commit the real credential file.

PLAYWRIGHT_BASE_URL=https://ptc.example.com
E2E_EVENT_ID=EVT-2407-0253

# Use one shared seeded password when all three test roles share it:
E2E_PASSWORD=replace-locally

# Or remove E2E_PASSWORD and provide all three role-specific passwords instead:
# E2E_VIEWER_PASSWORD=replace-locally
# E2E_SUPERVISOR_PASSWORD=replace-locally
# E2E_ADMIN_PASSWORD=replace-locally

# Optional username overrides. Defaults are viewer, supervisor, admin.
# E2E_VIEWER_USERNAME=viewer
# E2E_SUPERVISOR_USERNAME=supervisor
# E2E_ADMIN_USERNAME=admin
