# syntax=docker/dockerfile:1.7

FROM node:22.16.0-alpine AS build
WORKDIR /workspace

ENV DATABASE_URL=postgresql://ptc_build:build-only@127.0.0.1:5432/ptc_build?schema=public

RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/platform-api/package.json apps/platform-api/package.json
RUN pnpm install --frozen-lockfile --filter @ptc-bale/platform-api...

COPY apps/platform-api apps/platform-api
RUN pnpm --filter @ptc-bale/platform-api build

# Full tool image used only for Prisma migrations and the controlled first seed.
FROM build AS tools
ENV NODE_ENV=production
WORKDIR /workspace
CMD ["pnpm", "--filter", "@ptc-bale/platform-api", "db:migrate:deploy"]

# Build a production-only runtime tree while retaining generated Prisma Client.
FROM build AS package
RUN pnpm --filter @ptc-bale/platform-api deploy /runtime \
  && cd /runtime \
  && pnpm exec prisma generate \
  && pnpm prune --prod

FROM node:22.16.0-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app

RUN addgroup -S app && adduser -S -G app app

COPY --from=package --chown=app:app /runtime ./
COPY --from=build --chown=app:app /workspace/apps/platform-api/dist ./dist

USER app
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=5 \
  CMD wget -qO- http://127.0.0.1:4000/readyz >/dev/null || exit 1

CMD ["node", "dist/server.js"]
