generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  viewer
  supervisor
  admin
}

enum Outcome {
  completed
  missed
  incomplete
  unresolved
}

enum ReviewStatus {
  unreviewed
  confirmed
  dismissed
}

enum CameraStatus {
  online
  warning
  offline
}

enum AiStatus {
  processing
  degraded
  stopped
}

enum HealthState {
  healthy
  warning
  critical
  neutral
}

enum EvidenceState {
  available
  unavailable
  pending
}

enum EvidenceType {
  snapshot
  clip
  none
}

enum StepState {
  complete
  failed
  unknown
}

model User {
  id           String    @id @db.VarChar(64)
  username     String    @unique @db.VarChar(100)
  displayName  String    @db.VarChar(160)
  role         Role
  passwordHash String    @db.Text
  enabled      Boolean   @default(true)
  dataset      String    @db.VarChar(64)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]

  @@index([dataset])
  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  userId     String    @db.VarChar(64)
  expiresAt  DateTime
  lastSeenAt DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt, expiresAt])
  @@map("sessions")
}

model Camera {
  id            String       @id @db.VarChar(64)
  name          String       @db.VarChar(160)
  zone          String       @db.VarChar(160)
  status        CameraStatus
  aiStatus      AiStatus
  lastFrameAt   DateTime
  fps           Float
  streamQuality String       @db.VarChar(64)
  todayEvents   Int
  configVersion String       @db.VarChar(64)
  dataset       String       @db.VarChar(64)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  events        InspectionEvent[]

  @@index([dataset])
  @@index([status, aiStatus])
  @@map("cameras")
}

model InspectionEvent {
  id                String        @id @db.VarChar(64)
  cameraId          String        @db.VarChar(64)
  cameraName        String        @db.VarChar(160)
  zone              String        @db.VarChar(160)
  timestamp         DateTime
  outcome           Outcome
  reason            String        @db.Text
  confidence        Int
  reviewStatus      ReviewStatus
  summary           String        @db.Text
  evidenceAvailable Boolean
  remarks           String?       @db.VarChar(1000)
  reviewedBy        String?       @db.VarChar(160)
  reviewedAt        DateTime?
  modelVersion      String        @db.VarChar(64)
  ruleVersion       String        @db.VarChar(64)
  version           Int           @default(1)
  schemaVersion     Int           @default(1)
  dataset           String        @db.VarChar(64)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  camera            Camera        @relation(fields: [cameraId], references: [id], onDelete: Restrict)
  steps             EventStep[]
  evidence          EvidenceMetadata?

  @@index([dataset])
  @@index([timestamp(sort: Desc), id(sort: Desc)])
  @@index([cameraId, timestamp(sort: Desc)])
  @@index([outcome, timestamp(sort: Desc)])
  @@index([reviewStatus, timestamp(sort: Desc)])
  @@index([cameraId, outcome, reviewStatus, timestamp(sort: Desc)])
  @@map("inspection_events")
}

model EventStep {
  id        String          @id @default(uuid()) @db.Uuid
  eventId   String          @db.VarChar(64)
  sequence  Int
  label     String          @db.VarChar(200)
  state     StepState
  time      String?         @db.VarChar(32)
  event     InspectionEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, sequence])
  @@index([eventId])
  @@map("event_steps")
}

model HealthMetric {
  id        String      @id @db.VarChar(64)
  label     String      @db.VarChar(160)
  value     String      @db.VarChar(160)
  detail    String      @db.Text
  state     HealthState
  checkedAt DateTime
  source    String      @db.VarChar(64)
  dataset   String      @db.VarChar(64)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([dataset])
  @@index([state])
  @@map("health_metrics")
}

model EvidenceMetadata {
  id         String          @id @db.VarChar(96)
  eventId    String          @unique @db.VarChar(64)
  state      EvidenceState
  type       EvidenceType
  mimeType   String?         @db.VarChar(128)
  sizeBytes  Int?
  checksum   String?         @db.VarChar(160)
  storageKey String?         @db.Text
  dataset    String          @db.VarChar(64)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  event      InspectionEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([dataset])
  @@index([state])
  @@map("evidence_metadata")
}

model AuditLog {
  id               String   @id @default(uuid()) @db.Uuid
  actionId         String   @unique @db.Uuid
  actorId          String   @db.VarChar(64)
  actorDisplayName String   @db.VarChar(160)
  actorRole        Role
  action           String   @db.VarChar(120)
  targetType       String   @db.VarChar(120)
  targetId         String   @db.VarChar(96)
  before           Json?
  after            Json?
  correlationId    String   @db.VarChar(128)
  occurredAt       DateTime
  createdAt        DateTime @default(now())

  @@index([targetId, occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@index([occurredAt(sort: Desc)])
  @@map("audit_logs")
}
