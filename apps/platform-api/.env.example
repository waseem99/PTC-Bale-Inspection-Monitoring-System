NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://ptc_app:replace-with-strong-database-password@127.0.0.1:5432/ptc_bale?schema=public
SESSION_COOKIE_NAME=ptc_session
SESSION_TTL_HOURS=8

# false is allowed only for local HTTP development. Use true behind HTTPS.
COOKIE_SECURE=false
TRUST_PROXY=false
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:4173

# Supply privately. Use unique values outside local testing.
SEED_VIEWER_PASSWORD=replace-with-strong-viewer-password
SEED_SUPERVISOR_PASSWORD=replace-with-strong-supervisor-password
SEED_ADMIN_PASSWORD=replace-with-strong-admin-password

# Machine-to-machine ingestion. Required in production and never exposed to the browser.
INGESTION_SERVICE_TOKEN=replace-with-at-least-24-random-characters

# Evidence files remain outside PostgreSQL and outside the public web root.
EVIDENCE_ROOT=/var/lib/ptc-bale/evidence
MAX_EVIDENCE_BYTES=26214400

# Immutable release identity injected by the deployment pipeline.
BUILD_VERSION=development
BUILD_COMMIT=unknown
SCHEMA_VERSION=20260731-production-readiness

# Software simulator is for controlled development/UAT only and is forbidden in production.
SIMULATOR_ENABLED=false
