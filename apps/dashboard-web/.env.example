VITE_DATA_MODE=mock
VITE_API_BASE_URL=/api
VITE_REQUEST_TIMEOUT_MS=12000
VITE_MOCK_LATENCY_MS=420
VITE_MOCK_FAILURE_RATE=0
VITE_DEMO_PASSWORD=replace-for-shared-demo-ui-workflow
VITE_ALLOW_DEMO_CREDENTIALS=false
VITE_ENVIRONMENT_NAME=Isolated Development Demo
VITE_BUILD_VERSION=1.0.0

