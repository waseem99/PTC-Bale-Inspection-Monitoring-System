VITE_DATA_MODE=mock
VITE_API_BASE_URL=/api
VITE_REQUEST_TIMEOUT_MS=12000
VITE_MOCK_LATENCY_MS=420
VITE_MOCK_FAILURE_RATE=0
VITE_DEMO_PASSWORD=replace-for-shared-demo-ui-workflow
VITE_ALLOW_DEMO_CREDENTIALS=false
VITE_ENVIRONMENT_NAME=Isolated Development Demo
VITE_BUILD_VERSION=1.0.0

# Optional recorded-video preview overrides. HTTPS direct video URLs and Google Drive file links are supported.
# Leave empty to use the built-in shared Drive camera clips (no git media required).
VITE_CAMERA_01_PREVIEW_URL=
VITE_CAMERA_02_PREVIEW_URL=
VITE_CAMERA_03_PREVIEW_URL=
VITE_CAMERA_04_PREVIEW_URL=

# Container runtime only; these are not Vite/browser variables.
# DEMO_BASIC_AUTH_USER=reviewer
# DEMO_BASIC_AUTH_PASSWORD=replace-with-strong-hosting-password
