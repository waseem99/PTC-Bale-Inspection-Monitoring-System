# syntax=docker/dockerfile:1.7

FROM node:20.18.1-alpine AS build
WORKDIR /workspace

RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/dashboard-web/package.json apps/dashboard-web/package.json
RUN pnpm install --frozen-lockfile --filter @ptc-bale/dashboard-web...

COPY apps/dashboard-web apps/dashboard-web

ARG VITE_DATA_MODE=live
ARG VITE_ENVIRONMENT_NAME="PTC AWS Staging"
ARG VITE_BUILD_VERSION=aws-staging
ARG VITE_API_BASE_URL=/api
ARG VITE_ALLOW_DEMO_CREDENTIALS=false
ARG VITE_REQUEST_TIMEOUT_MS=12000
ARG VITE_MOCK_LATENCY_MS=0
ARG VITE_MOCK_FAILURE_RATE=0
ARG VITE_CAMERA_01_PREVIEW_URL=
ARG VITE_CAMERA_02_PREVIEW_URL=
ARG VITE_CAMERA_03_PREVIEW_URL=
ARG VITE_CAMERA_04_PREVIEW_URL=

ENV VITE_DATA_MODE=$VITE_DATA_MODE \
    VITE_ENVIRONMENT_NAME=$VITE_ENVIRONMENT_NAME \
    VITE_BUILD_VERSION=$VITE_BUILD_VERSION \
    VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_ALLOW_DEMO_CREDENTIALS=$VITE_ALLOW_DEMO_CREDENTIALS \
    VITE_REQUEST_TIMEOUT_MS=$VITE_REQUEST_TIMEOUT_MS \
    VITE_MOCK_LATENCY_MS=$VITE_MOCK_LATENCY_MS \
    VITE_MOCK_FAILURE_RATE=$VITE_MOCK_FAILURE_RATE \
    VITE_CAMERA_01_PREVIEW_URL=$VITE_CAMERA_01_PREVIEW_URL \
    VITE_CAMERA_02_PREVIEW_URL=$VITE_CAMERA_02_PREVIEW_URL \
    VITE_CAMERA_03_PREVIEW_URL=$VITE_CAMERA_03_PREVIEW_URL \
    VITE_CAMERA_04_PREVIEW_URL=$VITE_CAMERA_04_PREVIEW_URL

RUN pnpm --filter @ptc-bale/dashboard-web build

FROM nginx:1.27.3-alpine AS runtime
RUN apk add --no-cache apache2-utils \
  && rm -f /etc/nginx/conf.d/default.conf

COPY apps/dashboard-web/deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY apps/dashboard-web/deploy/docker-entrypoint.sh /usr/local/bin/dashboard-entrypoint.sh
COPY --from=build /workspace/apps/dashboard-web/dist /usr/share/nginx/html

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=5 \
  CMD wget -qO- http://127.0.0.1:8080/healthz >/dev/null || exit 1

CMD ["sh", "/usr/local/bin/dashboard-entrypoint.sh"]
